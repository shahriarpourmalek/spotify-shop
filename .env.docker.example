# Project information
PROJECT_NAME=spotify-shop
COMPOSE_PROJECT_NAME=spotify_shop

# Container names
APP_CONTAINER_NAME=spotify_shop_app
NGINX_CONTAINER_NAME=spotify_shop_nginx
MYSQL_CONTAINER_NAME=spotify_shop_mysql
REDIS_CONTAINER_NAME=spotify_shop_redis

# Image versions
PHP_VERSION=8.4
NGINX_VERSION=stable-alpine
MYSQL_VERSION=8.4
REDIS_VERSION=8-alpine

# Timezone
TIMEZONE=UTC

# Host and internal service ports
APP_PORT=9000
APP_INTERNAL_PORT=9000
NGINX_PORT=8080
NGINX_INTERNAL_PORT=80
MYSQL_PORT=3309
MYSQL_INTERNAL_PORT=3306
REDIS_PORT=6380
REDIS_INTERNAL_PORT=6379

# Application runtime
APP_NAME="Spotify Shop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=
APP_USER=laravel
APP_UID=1000
APP_GID=1000

# Laravel database settings used by the app container
DB_CONNECTION=mysql
MYSQL_HOST=mysql
MYSQL_DATABASE=spotify_shop
MYSQL_USER=spotify_shop
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret

# Laravel Redis settings used by the app container
REDIS_HOST=redis
REDIS_PASSWORD=

# Nginx
NGINX_CLIENT_MAX_BODY_SIZE=64m

# PHP ini
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=120
PHP_MAX_INPUT_VARS=3000
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_ENABLE_CLI=0
PHP_OPCACHE_MEMORY_CONSUMPTION=256
PHP_OPCACHE_INTERNED_STRINGS_BUFFER=16
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_REVALIDATE_FREQ=2

# PHP-FPM pool
PHP_FPM_PM_MAX_CHILDREN=20
PHP_FPM_PM_START_SERVERS=4
PHP_FPM_PM_MIN_SPARE_SERVERS=2
PHP_FPM_PM_MAX_SPARE_SERVERS=6
PHP_FPM_PM_MAX_REQUESTS=500

# Healthchecks
MYSQL_HEALTHCHECK_INTERVAL=10s
MYSQL_HEALTHCHECK_TIMEOUT=5s
MYSQL_HEALTHCHECK_RETRIES=5
MYSQL_HEALTHCHECK_START_PERIOD=30s
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=5
REDIS_HEALTHCHECK_START_PERIOD=10s
